# ==========================================
# College Chatbot Environment Variables
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
PORT=4000
ALLOWED_ORIGIN="*"

# ------------------------------------------
# Database Configuration
# ------------------------------------------
# PostgreSQL Connection String
DATABASE_URL="postgresql://username:password@localhost:5432/college_chatbot"

# Qdrant Vector Database
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="" # Leave empty if running Qdrant locally without auth

# ------------------------------------------
# Primary AI / LLM (Groq)
# ------------------------------------------
# Ultra-fast inference for chat, intent evaluation, routing & reranking
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_CHAT_MODEL="openai/gpt-oss-120b"
GROQ_FAST_MODEL="openai/gpt-oss-20b"
# (Alternative models if enabled on your plan: llama-3.3-70b-versatile, llama-3.1-8b-instant)

# ------------------------------------------
# Optional Embeddings Provider
# ------------------------------------------
# Groq does not offer embeddings. Set one of these if you need dense vector embeddings:
# GEMINI_API_KEY="your-gemini-api-key-here"
# OPENAI_API_KEY="your-openai-api-key-here"
# OPENROUTER_API_KEY="your-openrouter-key-here"

# ------------------------------------------
# Live Web Search (Tavily)
# ------------------------------------------
TAVILY_API_KEY="tvly-your-api-key-here"

# ------------------------------------------
# Frontend (Next.js) Configuration
# ------------------------------------------
# If placing this in the `web` folder, rename to `.env.local`
NEXT_PUBLIC_API_URL="http://127.0.0.1:4000"
