# ── Server Configuration ──────────────────────────────────────────
PORT=4006
NODE_ENV=development

# ── Security ─────────────────────────────────────────────────────
# CORS allowed origin (e.g., https://your-domain.com)
# Use '*' for development only
ALLOWED_ORIGIN=*

# ── Database (PostgreSQL) ────────────────────────────────────────
# Connection string: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://user:password@localhost:5432/college_chatbot

# ── Vector Search (Qdrant) ───────────────────────────────────────
# Local or cloud URL
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── Primary AI / LLM (Groq) ──────────────────────────────────────
# Required for fast chat streaming, routing, intent, and reranking
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
# (Alternative models if enabled on your plan: llama-3.3-70b-versatile, llama-3.1-8b-instant)

# ── Optional Embeddings Provider ─────────────────────────────────
# Groq does not provide vector embeddings.
# Set ONE of the following for dense vector search (768 dimensions):
# GEMINI_API_KEY=your_gemini_api_key
# OPENAI_API_KEY=your_openai_api_key
# OPENROUTER_API_KEY=your_openrouter_api_key
# If none is set, keyword matching and live web search will be used automatically.

# ── Search (Tavily) ──────────────────────────────────────────────
# Required for live web fallback search
TAVILY_API_KEY=your_tavily_api_key

# ── Voice / Speech (Eleven Labs) ──────────────────────────────────
# Required for text-to-speech functionality
ELEVEN_LABS_API_KEY=your_eleven_labs_api_key
